# Supabase Configuration
# Replace with your project details from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Google Gemini API Configuration (Clean Quest AI)
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/
# This key is strictly server-side and never exposed to the client browser.
GEMINI_API_KEY=your-gemini-api-key
